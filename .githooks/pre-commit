#!/usr/bin/env sh
set -eu

if [ -f "./mvnw.cmd" ] && [ "${OS:-}" = "Windows_NT" ]; then
    MVN="./mvnw.cmd"
elif [ -f "./mvnw" ]; then
    MVN="./mvnw"
else
    MVN="mvn"
fi

echo "[pre-commit] Checking formatting..."
$MVN spotless:check

echo "[pre-commit] Compiling tests..."
$MVN test-compile

echo "[pre-commit] Passed."
